{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "chrome-devtools-mcp@latest"
                ]
            },
            "linkedin": {
                "type": "local",
                "command": [
                    "uvx",
                    "mcp-server-linkedin@latest"
                ],
                "environment": {
                    "UV_HTTP_TIMEOUT": "300"
                }
            },
            "penpot": {
                "type": "remote",
                "url": "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_MCP_KEY}",
                "oauth": false
            },
            "linear": {
                "type": "remote",
                "url": "https://mcp.linear.app/mcp"
            }
        }
    }
}
